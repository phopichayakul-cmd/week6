# Copy this file to .env and fill in real values. NEVER commit .env to Git.
PORT=3000

# Long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m

# bcrypt cost factor (10-12 is reasonable for a lab machine)
BCRYPT_ROUNDS=10

# Passwords used ONLY by `npm run seed` to create the demo users
SEED_ADMIN_PASSWORD=choose-an-admin-password
SEED_STUDENT_PASSWORD=choose-a-student-password
