                  "const body = pm.response.json();",
                  "pm.test(\"Token returned\", () => pm.expect(body.token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"studentToken\", body.token);",
                  "pm.test(\"Response does not leak password / hash\", () => {",
                  "  const t = pm.response.text();",
                  "  pm.expect(t).to.not.include(\"passwordHash\");",
                  "  pm.expect(t).to.not.include(\"\\\"password\\\"\");",
