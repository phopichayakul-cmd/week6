        {
          "name": "Modified Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const [h, p, s] = pm.collectionVariables.get('studentToken').split('.');",
                  "const fromB64Url = (x) => atob(x.replace(/-/g, '+').replace(/_/g, '/'));",
                  "const toB64Url = (x) => btoa(x).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "const payload = JSON.parse(fromB64Url(p));",
                  "payload.role = 'admin';",
                  "pm.collectionVariables.set('tamperedToken', h + '.' + toB64Url(JSON.stringify(payload)) + '.' + s);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tamperedToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin"
              ]
            },
            "description": "Takes the student's token, changes the payload role to \"admin\", keeps the original signature."
          }
        },
