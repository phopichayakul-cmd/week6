        {
          "name": "Logout",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// log in a separate session just for this test",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/auth/login',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ username: pm.collectionVariables.get('studentUsername'), password: pm.collectionVariables.get('studentPassword') }) }",
                  "}, (err, res) => { pm.collectionVariables.set('logoutToken', res.json().token); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{logoutToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Logs in a separate session first (pre-request script) and logs THAT token out, so the other tests keep working."
          }
        }
